{
  "expo": {
    "name": "Connectx24",
    "slug": "Connectx24",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "connectx24",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.connectx24.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "connectx24 needs microphone access for voice calls and voice verification.",
        "UIBackgroundModes": ["audio", "voip"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090D16"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.connectx24"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef13d9c3-365c-419c-a9ec-19902bb68f4f"
      }
    }
  }
}
