{
  "expo": {
    "name": "ConnectX",
    "slug": "ConnectX",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "connectx",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.ConnectX.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Connect24x needs microphone access for voice calls and voice verification.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"]
      }
    },
    "android": {
      "package": "com.ConnectX",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090D16"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "queries": [
        {
          "scheme": "upi"
        },
        {
          "scheme": "phonepe"
        },
        {
          "scheme": "paytmmp"
        },
        {
          "scheme": "tez"
        },
        {
          "scheme": "bhim"
        },
        {
          "scheme": "amazonpay"
        },
        {
          "scheme": "credpay"
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/ringtone.wav"]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef13d9c3-365c-419c-a9ec-19902bb68f4f"
      }
    }
  }
}
