{
  "expo": {
    "name": "ConnectX",
    "slug": "ConnectX",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "connectx",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.ConnectX.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Connect24x needs microphone access for voice calls and voice verification.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"]
      }
    },
    "android": {
      "package": "com.ConnectX",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090D16"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D16",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/ringtone.wav"]
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "./plugins/withZegoBuildConfig",
      [
        "expo-build-properties",
        {
          "android": {
            "queries": [
              { "scheme": "upi" },
              { "scheme": "phonepe" },
              { "scheme": "paytmmp" },
              { "scheme": "tez" },
              { "scheme": "bhim" },
              { "scheme": "amazonpay" },
              { "scheme": "credpay" }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7b48c6e5-e81b-4e33-b898-3fe8d2122626"
      }
    },
    "owner": "mehebub1"
  }
}
